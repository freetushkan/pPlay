                                         int64_t target_timecode, int flags)
 {
@@ -3395,6 +3508,12 @@ static void demux_mkv_seek(demuxer_t *demuxer, double seek_pts, int flags)
         seek_pts = MPMAX(seek_pts, 0);
         int64_t target_timecode = seek_pts * 1e9 + 0.5;

+        int64_t noindex_tc = seek_without_index(demuxer, target_timecode);
